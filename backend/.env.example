SECRET_KEY=change-me-to-something-random
# Supabase: paste the Session Pooler or direct Postgres connection string.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Alpaca Market Data API — https://alpaca.markets/ (free tier, no card needed)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
